<div class="container">
    <text class="brand">AceTennis</text>
    <text class="state" if="{{ currentScreen !== 'QUICK_RESULT' }}">{{ currentScreen }}</text>
    <text class="quick-title" if="{{ currentScreen === 'QUICK_RESULT' }}">SESSION COMPLETE</text>
    <text class="session-status">{{ sessionStatus }}</text>
    <text class="quick-label" if="{{ currentScreen === 'QUICK_RESULT' }}">Duration</text>
    <text class="elapsed-status">{{ elapsedTime }}</text>
    <text class="score-label" if="{{ currentScreen === 'ACTIVE_WORKOUT' }}">Score:</text>
    <text class="score-display" if="{{ currentScreen === 'ACTIVE_WORKOUT' }}">{{ scoreDisplay }}</text>
    <div class="control-row" if="{{ currentScreen === 'ACTIVE_WORKOUT' }}">
        <div class="score-control" onclick="onPlayerPoint">
            <text class="control-label">You +</text>
        </div>
        <div class="score-control" onclick="onOpponentPoint">
            <text class="control-label">Opp +</text>
        </div>
    </div>
    <text class="confirmation-message" if="{{ currentScreen === 'FINISH_CONFIRMATION' }}">Finish session?</text>
    <div class="start" if="{{ currentScreen === 'READY' }}" onclick="onStart">
        <text class="start-label">Start</text>
    </div>
    <div class="control-row" if="{{ currentScreen === 'ACTIVE_WORKOUT' }}">
        <div class="score-control" onclick="onPause">
            <text class="control-label">Pause</text>
        </div>
        <div class="score-control" onclick="onRequestFinish">
            <text class="control-label">Finish</text>
        </div>
    </div>
    <div class="start" if="{{ currentScreen === 'PAUSED' }}" onclick="onResume">
        <text class="start-label">Resume</text>
    </div>
    <div class="start" if="{{ currentScreen === 'PAUSED' }}" onclick="onRequestFinish">
        <text class="start-label">Finish</text>
    </div>
    <div class="start" if="{{ currentScreen === 'FINISH_CONFIRMATION' }}" onclick="onCancelFinish">
        <text class="start-label">Continue</text>
    </div>
    <div class="start" if="{{ currentScreen === 'FINISH_CONFIRMATION' }}" onclick="onConfirmFinish">
        <text class="start-label">Finish</text>
    </div>
    <text class="quick-metric" if="{{ currentScreen === 'QUICK_RESULT' }}">{{ quickHeartRate }}</text>
    <text class="quick-metric" if="{{ currentScreen === 'QUICK_RESULT' }}">{{ quickSwingCount }}</text>
    <text class="quick-metric" if="{{ currentScreen === 'QUICK_RESULT' }}">{{ quickScore }}</text>
    <div class="start" if="{{ currentScreen === 'QUICK_RESULT' }}" onclick="onDone">
        <text class="start-label">Done</text>
    </div>
</div>
