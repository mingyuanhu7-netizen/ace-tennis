<div class="container">
    <text class="title" if="{{ pageMode === 'STATUS' }}">{{ title }}</text>
    <text class="key" if="{{ pageMode === 'STATUS' }}">KEY: {{ keyLabel }}</text>
    <text class="status" if="{{ pageMode === 'STATUS' }}">STARTUP: {{ startupRead }}</text>
    <text class="status" if="{{ pageMode === 'STATUS' }}">OP: {{ lastOperation }}</text>
    <text class="status" if="{{ pageMode === 'STATUS' }}">RESULT: {{ lastResult }}</text>
    <text class="error" if="{{ pageMode === 'STATUS' }}">ERROR: {{ lastError }}</text>
    <div class="action" if="{{ pageMode === 'STATUS' }}" onclick="onShowOperations">
        <text class="action-label">OPERATIONS</text>
    </div>
    <text class="title" if="{{ pageMode === 'OPERATIONS' }}">STORAGE TEST</text>
    <text class="status" if="{{ pageMode === 'OPERATIONS' }}">OP: {{ lastOperation }}</text>
    <text class="status" if="{{ pageMode === 'OPERATIONS' }}">RESULT: {{ lastResult }}</text>
    <text class="error" if="{{ pageMode === 'OPERATIONS' }}">ERROR: {{ lastError }}</text>
    <div class="action" if="{{ pageMode === 'OPERATIONS' }}" onclick="onRead">
        <text class="action-label">READ</text>
    </div>
    <div class="action" if="{{ pageMode === 'OPERATIONS' }}" onclick="onWrite">
        <text class="action-label">WRITE</text>
    </div>
    <div class="action secondary" if="{{ pageMode === 'OPERATIONS' }}" onclick="onShowAdvanced">
        <text class="action-label">MORE</text>
    </div>
    <div class="back" if="{{ pageMode === 'OPERATIONS' }}" onclick="onShowStatus">
        <text class="back-label">STATUS</text>
    </div>
    <text class="title" if="{{ pageMode === 'ADVANCED' }}">STORAGE MORE</text>
    <text class="status" if="{{ pageMode === 'ADVANCED' }}">OP: {{ lastOperation }}</text>
    <text class="status" if="{{ pageMode === 'ADVANCED' }}">RESULT: {{ lastResult }}</text>
    <text class="error" if="{{ pageMode === 'ADVANCED' }}">ERROR: {{ lastError }}</text>
    <div class="action" if="{{ pageMode === 'ADVANCED' }}" onclick="onOverwrite">
        <text class="action-label">OVERWRITE</text>
    </div>
    <div class="action" if="{{ pageMode === 'ADVANCED' }}" onclick="onDelete">
        <text class="action-label">DELETE</text>
    </div>
    <div class="action secondary" if="{{ pageMode === 'ADVANCED' }}" onclick="onInvalidKey">
        <text class="action-label">BAD KEY</text>
    </div>
    <div class="back" if="{{ pageMode === 'ADVANCED' }}" onclick="onShowOperations">
        <text class="back-label">BACK</text>
    </div>
</div>
