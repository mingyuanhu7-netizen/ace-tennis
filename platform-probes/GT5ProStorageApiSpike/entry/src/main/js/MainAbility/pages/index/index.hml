<div class="container">
    <text class="title" if="{{ pageMode === 'STATUS' }}">{{ title }}</text>
    <text class="key" if="{{ pageMode === 'STATUS' }}">ID: {{ keyLabel }}</text>
    <text class="status" if="{{ pageMode === 'STATUS' }}">STARTUP: {{ startupRead }}</text>
    <text class="status" if="{{ pageMode === 'STATUS' }}">OP: {{ lastOperation }}</text>
    <text class="status" if="{{ pageMode === 'STATUS' }}">RESULT: {{ lastResult }}</text>
    <text class="error" if="{{ pageMode === 'STATUS' }}">ERROR: {{ lastError }}</text>
    <div class="action" if="{{ pageMode === 'STATUS' }}" onclick="onShowOperations">
        <text class="action-label">OPERATIONS</text>
    </div>

    <text class="title" if="{{ pageMode === 'OPERATIONS' }}">SESSION TEST</text>
    <text class="key" if="{{ pageMode === 'OPERATIONS' }}">ID: {{ keyLabel }}</text>
    <text class="status" if="{{ pageMode === 'OPERATIONS' }}">OP: {{ lastOperation }}</text>
    <text class="status" if="{{ pageMode === 'OPERATIONS' }}">RESULT: {{ lastResult }}</text>
    <text class="error" if="{{ pageMode === 'OPERATIONS' }}">ERROR: {{ lastError }}</text>
    <div class="action" if="{{ pageMode === 'OPERATIONS' }}" onclick="onSave">
        <text class="action-label">SAVE</text>
    </div>
    <div class="action" if="{{ pageMode === 'OPERATIONS' }}" onclick="onRead">
        <text class="action-label">READ</text>
    </div>
    <div class="action" if="{{ pageMode === 'OPERATIONS' }}" onclick="onShowDiagnostic">
        <text class="action-label">A/B WRITE</text>
    </div>
    <div class="back" if="{{ pageMode === 'OPERATIONS' }}" onclick="onShowStatus">
        <text class="back-label">STATUS</text>
    </div>

    <text class="title" if="{{ pageMode === 'RESULT' }}">SESSION STORED</text>
    <text class="status" if="{{ pageMode === 'RESULT' }}">OP: {{ lastOperation }}</text>
    <text class="status" if="{{ pageMode === 'RESULT' }}">RESULT: {{ lastResult }}</text>
    <text class="info" if="{{ pageMode === 'RESULT' }}">SCHEMA: {{ detailSchema }}</text>
    <text class="info" if="{{ pageMode === 'RESULT' }}">DURATION: {{ detailDuration }}</text>
    <text class="info" if="{{ pageMode === 'RESULT' }}">SETS: {{ detailSets }}</text>
    <text class="info" if="{{ pageMode === 'RESULT' }}">GAMES: {{ detailGames }}</text>
    <text class="error" if="{{ pageMode === 'RESULT' }}">ERROR: {{ lastError }}</text>
    <div class="action" if="{{ pageMode === 'RESULT' }}" onclick="onVerify">
        <text class="action-label">VERIFY</text>
    </div>
    <div class="back" if="{{ pageMode === 'RESULT' }}" onclick="onShowOperations">
        <text class="back-label">BACK</text>
    </div>

    <text class="title" if="{{ pageMode === 'DIAGNOSTIC' }}">WRITE DIAGNOSTIC</text>
    <text class="status" if="{{ pageMode === 'DIAGNOSTIC' }}">A: SIMPLE JSON</text>
    <text class="info" if="{{ pageMode === 'DIAGNOSTIC' }}">{{ diagnosticA }}</text>
    <text class="status" if="{{ pageMode === 'DIAGNOSTIC' }}">B: SESSION JSON</text>
    <text class="info" if="{{ pageMode === 'DIAGNOSTIC' }}">{{ diagnosticB }}</text>
    <div class="action" if="{{ pageMode === 'DIAGNOSTIC' }}" onclick="onRunDiagnostic">
        <text class="action-label">RUN A/B</text>
    </div>
    <div class="back" if="{{ pageMode === 'DIAGNOSTIC' }}" onclick="onShowOperations">
        <text class="back-label">BACK</text>
    </div>
    <div class="action" if="{{ pageMode === 'DIAGNOSTIC' }}" onclick="onShowSizeDiagnostic">
        <text class="action-label">SIZE A-F</text>
    </div>

    <text class="title" if="{{ pageMode === 'SIZE' }}">SIZE TEST</text>
    <text class="info" if="{{ pageMode === 'SIZE' }}">A {{ sizeA }}</text>
    <text class="info" if="{{ pageMode === 'SIZE' }}">B {{ sizeB }}</text>
    <text class="info" if="{{ pageMode === 'SIZE' }}">C {{ sizeC }}</text>
    <text class="info" if="{{ pageMode === 'SIZE' }}">D {{ sizeD }}</text>
    <text class="info" if="{{ pageMode === 'SIZE' }}">E {{ sizeE }}</text>
    <text class="info" if="{{ pageMode === 'SIZE' }}">F {{ sizeF }}</text>
    <div class="action" if="{{ pageMode === 'SIZE' }}" onclick="onRunSizeDiagnostic">
        <text class="action-label">RUN SIZE</text>
    </div>
    <div class="back" if="{{ pageMode === 'SIZE' }}" onclick="onShowDiagnostic">
        <text class="back-label">BACK</text>
    </div>
</div>
